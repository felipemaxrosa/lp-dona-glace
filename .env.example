# Sanity — preencha com os dados do seu projeto (sanity.io/manage) em .env.local
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Token de ESCRITA (só para o script de seed; não comitar). Crie em sanity.io/manage > API > Tokens
SANITY_API_WRITE_TOKEN=

# Segredo do webhook de revalidação (defina um valor qualquer e repita no webhook do Sanity)
SANITY_REVALIDATE_SECRET=

# URL pública do site (canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=https://donaglace.com.br
